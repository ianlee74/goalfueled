    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <!-- Needed to construct HttpRequest (DefaultHttpContext) when testing the auth flow. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GoalFueled.Api\GoalFueled.Api.csproj" />
    <ProjectReference Include="..\..\src\GoalFueled.Data\GoalFueled.Data.csproj" />
    <ProjectReference Include="..\..\src\GoalFueled.Domain\GoalFueled.Domain.csproj" />
  </ItemGroup>

</Project>
