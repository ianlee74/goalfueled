# Entra External ID sign-in for the SPA.
#
# Leave these UNSET for local development — the app falls back to the preset X-Dev-* dev logins
# (see src/web/src/auth/devUsers.ts), so `npm run dev` needs no config.
#
# Set all three required vars (e.g. in a deployed build's environment, or a local .env.local) to
# switch the app into "entra" mode, where sign-in opens the Entra External ID user flow. That flow
# offers Google AND — if you enable the Email-with-password local account provider in the tenant
# user flow — email+password accounts, which let you create as many test logins as you want without
# any Google accounts.
#
# These are baked into the static bundle at build time and are NOT secrets (the SPA is a public
# client); the client id and authority are safe to expose.

# Absolute API origin, used when the SPA must call the Function App cross-origin (e.g. a Static Web App
# on the Free tier, which can't proxy /api to a linked backend). Leave EMPTY for local dev (Vite proxies
# /api to the Functions host) or when the SWA proxies /api to a linked backend. The API's CORS must allow
# the SPA origin. Example: https://goalfueled-api-dev-stz5cq.azurewebsites.net
VITE_API_BASE_URL=

# SPA app registration (client) id.
VITE_ENTRA_CLIENT_ID=

# Authority URL for the Entra External ID tenant.
# Example: https://goalfueled.ciamlogin.com/00000000-0000-0000-0000-000000000000/v2.0
VITE_ENTRA_AUTHORITY=

# Scope the SPA requests an access token for. Exposed by the API app registration.
# Example: api://00000000-0000-0000-0000-000000000000/access_as_user
VITE_ENTRA_API_SCOPE=

# Optional: authority host MSAL should trust. Derived from VITE_ENTRA_AUTHORITY when omitted.
# Example: goalfueled.ciamlogin.com
VITE_ENTRA_KNOWN_AUTHORITY=
